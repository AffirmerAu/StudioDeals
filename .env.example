# Copy to .env.local and fill in.
# Project URL:  Supabase -> Integrations -> Data API
# Anon key:     Supabase -> Settings -> API Keys
#
# Only VITE_-prefixed vars reach the browser bundle. The anon key is
# safe there; the service_role key is NOT and must never appear here.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
